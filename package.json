{
  "name": "@mcpulse/sdk",
  "version": "0.1.3",
  "description": "Analytics for MCP servers. One import, one wrap \u2014 see which of your tools actually work for the models calling them.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.12"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "analytics",
    "observability",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getmcpulse/mcpulse-sdk.git"
  },
  "homepage": "https://github.com/getmcpulse/mcpulse-sdk#readme",
  "bugs": "https://github.com/getmcpulse/mcpulse-sdk/issues",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.20.1",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
